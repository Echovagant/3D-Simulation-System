{
  "name": "vue_demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" -- && npm test && npm run verify:clean && npm run verify:no-babylon && npm run verify:light-contrast && npm run verify:docs && npm run verify:bundle-size && npm run verify:deps && npm run verify:tailwind && npm run verify:model-metadata && npm run verify:readme && npm run verify:spec && npm run verify:asset-licenses && npm run verify:no-secrets",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "verify:clean": "node scripts/check-no-emit-artifacts.mjs",
    "verify:no-babylon": "node scripts/check-no-babylon.mjs",
    "verify:light-contrast": "node scripts/check-light-contrast.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "verify:deps": "node scripts/check-dead-deps.mjs",
    "verify:docs": "node scripts/check-docs.mjs",
    "verify:bundle-size": "node scripts/check-entry-bundle-size.mjs",
    "verify:tailwind": "node scripts/check-tailwind-classes.mjs",
    "verify:model-metadata": "node scripts/check-model-metadata.mjs",
    "verify:readme": "node scripts/check-readme.mjs",
    "verify:spec": "node scripts/check-simulation-spec.mjs",
    "verify:offline": "node scripts/check-offline.mjs",
    "verify:backend": "node scripts/check-python-gates.mjs",
    "gen:api-contract": "node scripts/gen-api-contract.mjs",
    "verify:api-contract": "node scripts/check-api-contract.mjs",
    "build:all": "npm run build && npm run verify:backend",
    "gen:thumbnails": "node scripts/render-model-thumbnails.mjs",
    "verify:all": "npm run verify:clean && npm run verify:no-babylon && npm run verify:light-contrast && npm run verify:docs && npm run verify:deps && npm run verify:tailwind && npm run verify:bundle-size && npm run verify:model-metadata && npm run verify:readme && npm run verify:spec && npm run verify:asset-licenses && npm run verify:no-secrets && npm run verify:offline",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "gen:models": "node scripts/generate-model-assets.mjs",
    "verify:asset-licenses": "node scripts/check-asset-licenses.mjs",
    "gen:brand": "node scripts/generate-brand-assets.mjs",
    "gen:docs": "node scripts/generate-docs-assets.mjs",
    "record:demo": "node scripts/record-demo.mjs",
    "verify:no-secrets": "node scripts/check-no-secrets.mjs",
    "verify:llm-live": "node scripts/verify-llm-live.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.19.3",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "dompurify": "^3.4.17",
    "marked": "^16.3.0",
    "pinia": "^3.0.3",
    "three": "^0.180.0",
    "vue": "^3.5.42",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.18.1",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.1",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.29.0",
    "eslint-plugin-vue": "~10.2.0",
    "jiti": "^2.4.2",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.5.3",
    "typescript": "~5.8.0",
    "vite": "^6.4.3",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-vue-devtools": "^7.7.7",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.2.10"
  }
}
